{
  "name": "user-service",
  "version": "1.0.0",
  "description": "User authentication and profile management microservice",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch=true src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.config.unit.js",
    "test:integration": "jest --config jest.config.integration.js",
    "test:e2e": "jest --config jest.config.e2e.js",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "migrate": "npm run build && node dist/migrations/run.js",
    "migrate:rollback": "npm run build && node dist/migrations/rollback.js",
    "seed": "npm run build && node dist/seeds/run.js",
    "security:audit": "npm audit",
    "security:scan": "snyk test",
    "docker:build": "docker build -f Dockerfile.prod -t user-service:latest .",
    "docker:run": "docker run -p 3000:3000 user-service:latest",
    "docs": "typedoc src"
  },
  "dependencies": {
    "express": "^4.18.2",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.0",
    "redis": "^4.6.10",
    "amqplib": "^0.10.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "axios": "^1.5.0",
    "pino": "^8.16.0",
    "prom-client": "^15.0.0",
    "joi": "^17.10.2",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.0.0",
    "uuid": "^9.0.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.5",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "typedoc": "^0.25.1",
    "snyk": "^1.1230.0",
    "tsconfig-paths": "^4.4.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/microservices.git"
  },
  "keywords": [
    "microservices",
    "nodejs",
    "typescript",
    "express",
    "authentication"
  ],
  "author": "Your Team",
  "license": "MIT"
}
